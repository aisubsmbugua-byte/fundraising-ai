# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App's own deployed origin -- needed server-side (invite actions have
# no window.location) for Supabase Auth invite redirectTo URLs.
NEXT_PUBLIC_SITE_URL=

# Anthropic (server-only — never expose to client)
ANTHROPIC_API_KEY=

# Resend (Slice 8+, server-only)
RESEND_API_KEY=
# The From address funder-facing sends go out under (e.g. "Jane Doe
# <jane@yourdomain.org>"). Must be on a domain verified in Resend.
# Both values are read only in lib/send-draft.ts -- never near a client.
RESEND_FROM_EMAIL=

# Assistant (STATE item 87, ruling 0037) -- all server-only, never near a client.
# Meta's Model API (Muse Spark), OpenAI-compatible chat completions. The key is
# read only in lib/assistant/config.ts and used only in lib/assistant/provider.ts.
# With no key the assistant refuses plainly before anything is recorded.
MODEL_API_KEY=
# Optional. Default https://api.meta.ai/v1
MODEL_API_BASE_URL=
# Optional. Default muse-spark-1.1
ASSISTANT_MODEL=
# Comma-separated organization ids the assistant is switched on for. Absent or
# empty means off for everyone (the same encoding as the sending switch).
ASSISTANT_ENABLED_ORG_IDS=

# External agent connector (STATE item 98, ruling 0039) -- server-side.
# The canonical public origin of this deployment: the address documented on the
# Connect Muse page and used for approval links. It must be the FINAL host with
# no redirect in front of it (a redirect makes some clients drop the
# Authorization header). Optional; the default is https://fundraising-ai.vercel.app.
# The connector also uses SUPABASE_SERVICE_ROLE_KEY, in exactly one module
# (lib/agent/mint.ts), only to start a session for a verified token's owner.
AGENT_PUBLIC_ORIGIN=
