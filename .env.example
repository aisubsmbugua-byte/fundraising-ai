# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App's own deployed origin -- needed server-side (invite actions have
# no window.location) for Supabase Auth invite redirectTo URLs.
NEXT_PUBLIC_SITE_URL=

# Anthropic (server-only — never expose to client)
ANTHROPIC_API_KEY=

# Resend (Slice 8+, server-only)
RESEND_API_KEY=
# The From address funder-facing sends go out under (e.g. "Jane Doe
# <jane@yourdomain.org>"). Must be on a domain verified in Resend.
# Both values are read only in lib/send-draft.ts -- never near a client.
RESEND_FROM_EMAIL=
